# Normalize line endings: store text as LF in the repo, let Git auto-detect text vs binary.
* text=auto

# Force LF for source/config so Windows checkouts don't reintroduce CRLF churn.
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.xml  text eol=lf
*.css  text eol=lf
*.scss text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Treat known binary assets as binary (never normalize).
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  binary
*.mpk  binary
*.pdf  binary
*.woff  binary
*.woff2 binary
*.ttf  binary
*.eot  binary
