# Normalize all text files to LF, in the repo and in the working tree (all platforms).
# Git auto-detects text vs binary; eol=lf stops Windows checkouts reintroducing CRLF.
* text=auto eol=lf

# Treat known binary assets as binary (never normalize / never touch line endings).
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.mpk   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
